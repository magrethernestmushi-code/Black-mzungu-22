# Copy to .env (never commit .env). No real secrets belong in this file.
PORT=3000
NODE_ENV=production
# Required in production: protects every AI route. Choose a long random value.
STUDIO_ACCESS_TOKEN=
# ACE-Step 1.5 server you run yourself (see docs/AI_SETUP.md). Leave empty to disable AI music.
ACESTEP_API_URL=
ACESTEP_API_KEY=
ACESTEP_AUDIO_FORMAT=mp3
# Optional tuning
GENERATE_PER_HOUR=10
MAX_DURATION_SEC=240
JOB_TIMEOUT_MS=600000
